<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sondhan.controller.HomeController"
            style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
            prefWidth="1000.0" prefHeight="680.0">

    <!-- ── Header ──────────────────────────────────────────────────────────── -->
    <top>
        <HBox style="-fx-background-color: #FFFFFF; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <VBox>
                <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;"
                       style="-fx-text-fill: #117065; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="AI Fact Checker"
                       style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="apiKeyStatusLabel" text="No API Key"
                   style="-fx-background-color: #F1F5F9; -fx-text-fill: #475569; -fx-background-radius: 20; -fx-padding: 4 10; -fx-font-size: 12px;"/>
            <Button text="&#x1F511; API Key"
                    style="-fx-background-color: #FFFFFF; -fx-text-fill: #117065; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-color: #117065; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 14; -fx-cursor: hand;"
                    onAction="#handleApiKey"/>
            <Button text="&#x1F4DC; History"
                    style="-fx-background-color: #FFFFFF; -fx-text-fill: #117065; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-color: #117065; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 14; -fx-cursor: hand;"
                    onAction="#handleHistory"/>
            <Label fx:id="userNameLabel"
                   style="-fx-text-fill: #334155; -fx-font-size: 13px;"/>
            <Button text="Logout"
                    style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 6;"
                    onAction="#handleLogout"/>
        </HBox>
    </top>

    <!-- ── Body ────────────────────────────────────────────────────────────── -->
    <center>
        <HBox spacing="16.0">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- LEFT PANEL: Input -->
            <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;"
                  spacing="14.0" prefWidth="420.0" minWidth="360.0">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                <Label text="Verify a Claim"
                       style="-fx-text-fill: #334155; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                <Label text="Upload an image or type a claim below"
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>

                <TabPane fx:id="inputTabPane">

                    <!-- Image Tab -->
                    <Tab fx:id="imageTab" text="&#x1F5BC; Image" closable="false">
                        <VBox spacing="12.0">
                            <padding><Insets top="12"/></padding>

                            <!-- Drop zone -->
                            <StackPane fx:id="dropZone"
                                       style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 2; -fx-border-style: dashed; -fx-cursor: hand;"
                                       prefHeight="160.0" onMouseClicked="#handleBrowse">
                                <VBox alignment="CENTER" spacing="8.0">
                                    <Label text="&#x1F4E4;" style="-fx-font-size:36px;"/>
                                    <Label fx:id="dropLabel" text="Drag &amp; Drop image here"
                                           style="-fx-text-fill: #117065; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                    <Label text="or click to browse"
                                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                                </VBox>
                                <ImageView fx:id="previewImage" visible="false"
                                           fitWidth="380.0" fitHeight="155.0"
                                           preserveRatio="true"/>
                            </StackPane>

                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Button text="Browse..."
                                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #117065; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-color: #117065; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 14; -fx-cursor: hand;"
                                        onAction="#handleBrowse"/>
                                <Button fx:id="clearImageBtn" text="&#x2715; Clear"
                                        style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 6;"
                                        onAction="#handleClearImage"/>
                                <Label fx:id="fileNameLabel" text="No file selected"
                                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>
                    </Tab>

                    <!-- Text Tab -->
                    <Tab text="&#x1F4AC; Text Claim" closable="false">
                        <VBox spacing="10.0">
                            <padding><Insets top="12"/></padding>
                            <Label text="Paste or type a claim to verify:"
                                   style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold;"/>
                            <TextArea fx:id="textInputArea"
                                      promptText="e.g. Dhaka has been the capital of Bangladesh since 1971..."
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-prompt-text-fill: #94A3B8; -fx-font-size: 14px; -fx-control-inner-background: #FFFFFF;"
                                      prefHeight="190.0" wrapText="true"/>
                        </VBox>
                    </Tab>
                </TabPane>

                <!-- Loading row -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" minHeight="28.0">
                    <ProgressIndicator fx:id="loadingSpinner" prefHeight="24.0" prefWidth="24.0"/>
                    <Label fx:id="loadingLabel" text="Analysing..."
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                </HBox>

                <Button fx:id="checkBtn" text="&#x1F50D;  Check Fact"
                        style="-fx-background-color: #117065; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 20; -fx-cursor: hand; -fx-pref-height: 44;"
                        maxWidth="Infinity" onAction="#handleCheck"/>
            </VBox>

            <!-- RIGHT PANEL: Results -->
            <ScrollPane HBox.hgrow="ALWAYS" fitToWidth="true"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="0.0">

                    <!-- Empty State -->
                    <VBox fx:id="emptyState" alignment="CENTER" spacing="14.0" prefHeight="480.0">
                        <Label text="&#x1F50E;" style="-fx-font-size:64px;"/>
                        <Label text="Results will appear here"
                               style="-fx-text-fill: #334155; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        <Label text="Upload an image or enter a claim, then click Check Fact."
                               style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                               wrapText="true" textAlignment="CENTER" maxWidth="300.0"/>
                    </VBox>

                    <!-- Result Panel -->
                    <VBox fx:id="resultPanel"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;"
                          spacing="16.0">
                        <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Button text="&#x2190; Back"
                                    style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 6;"
                                    onAction="#handleClearResult"/>
                            <Label text="Fact-Check Result"
                                   style="-fx-text-fill: #334155; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="preloadedBadge" text="&#x26A1; Preloaded"
                                   style="-fx-background-color: #E1F5FE; -fx-text-fill: #0288D1; -fx-background-radius: 20; -fx-padding: 3 10; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                        </HBox>

                        <!-- Claim -->
                        <VBox style="-fx-background-color: #F8FAFC; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-border-width: 1;"
                              spacing="6.0">
                            <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
                            <Label text="CLAIM"
                                   style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Label fx:id="claimLabel"
                                   style="-fx-text-fill: #334155; -fx-font-size: 14px;"
                                   wrapText="true"/>
                        </VBox>

                        <!-- Verdict + Confidence -->
                        <HBox spacing="16.0" alignment="CENTER_LEFT">
                            <Label fx:id="verdictLabel" text="UNVERIFIED"
                                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 6 16; -fx-background-radius: 20; -fx-background-color: #F1F3F4; -fx-text-fill: #5F6368; -fx-border-color: #E8EAED; -fx-border-width: 1; -fx-border-radius: 20;"/>
                            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <Label text="CONFIDENCE"
                                           style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                    <Label fx:id="confidencePctLabel" text="0%"
                                           style="-fx-text-fill: #117065; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                </HBox>
                                <ProgressBar fx:id="confidenceBar" progress="0.0"
                                             style="-fx-accent: #117065; -fx-pref-height: 8; -fx-background-radius: 4;"
                                             maxWidth="Infinity"/>
                            </VBox>
                        </HBox>

                        <!-- Explanation -->
                        <VBox spacing="6.0">
                            <Label text="EXPLANATION"
                                   style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <TextArea fx:id="explanationArea" prefHeight="120.0"
                                      style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-control-inner-background: #FFFFFF;"
                                      editable="false" wrapText="true"/>
                        </VBox>

                        <!-- Sources -->
                        <VBox spacing="6.0">
                            <Label text="SOURCES"
                                   style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <VBox fx:id="sourcesBox" spacing="4.0"/>
                        </VBox>

                        <!-- Summary -->
                        <VBox fx:id="summaryBox" spacing="6.0">
                            <Label text="10-POINT SUMMARY"
                                   style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <Label fx:id="summaryLabel" wrapText="true"
                                   style="-fx-text-fill: #64748B; -fx-font-size: 13px;"/>
                        </VBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>
</BorderPane>
