<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sondhan.controller.RegisterController"
           styleClass="root-pane">

    <VBox styleClass="auth-card" maxWidth="420.0" alignment="CENTER" spacing="16.0">
        <padding><Insets top="40" right="48" bottom="40" left="48"/></padding>

        <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;" styleClass="brand-logo"/>
        <Label text="Create Account" styleClass="brand-subtitle"/>

        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="330.0"/>

        <VBox spacing="10.0">
            <Label text="Full Name" styleClass="field-label"/>
            <TextField fx:id="nameField" promptText="Your name" styleClass="input-field"/>

            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com" styleClass="input-field"/>

            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Min 6 characters" styleClass="input-field"/>

            <Label text="Confirm Password" styleClass="field-label"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat password"
                           styleClass="input-field" onAction="#handleRegister"/>
        </VBox>

        <ProgressIndicator fx:id="loadingSpinner" prefHeight="28.0"/>

        <Button fx:id="registerBtn" text="Create Account" styleClass="btn-primary"
                maxWidth="Infinity" onAction="#handleRegister"/>

        <HBox alignment="CENTER" spacing="6.0">
            <Label text="Already have an account?" styleClass="text-muted"/>
            <Hyperlink text="Sign in" onAction="#handleBackToLogin" styleClass="link"/>
        </HBox>
    </VBox>
</StackPane>
