<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sondhan.controller.HistoryController"
            styleClass="root-pane" prefWidth="1000.0" prefHeight="680.0">

    <!-- Header -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;" styleClass="header-logo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userNameLabel" styleClass="user-label"/>
            <Button text="&#x2190; Back" styleClass="btn-secondary" onAction="#handleBack"/>
            <Button text="&#x1F504; Refresh" styleClass="btn-ghost"  onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="14.0">
            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

            <!-- Table -->
            <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Search History" styleClass="panel-title" HBox.hgrow="ALWAYS"/>
                    <Button text="&#x1F5D1; Delete Selected" styleClass="btn-danger"
                            onAction="#handleDeleteSelected"/>
                </HBox>

                <ProgressIndicator fx:id="loadingSpinner" prefHeight="30.0"/>
                <Label fx:id="emptyLabel" text="No history yet — run a fact-check to get started."
                       styleClass="text-muted" visible="false"/>

                <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="history-table">
                    <columns>
                        <TableColumn fx:id="dateCol"    text="Date"       prefWidth="150"/>
                        <TableColumn fx:id="typeCol"    text="Type"       prefWidth="70"/>
                        <TableColumn fx:id="claimCol"   text="Claim"      prefWidth="320"/>
                        <TableColumn fx:id="verdictCol" text="Verdict"    prefWidth="110"/>
                        <TableColumn fx:id="confCol"    text="Conf %" prefWidth="70"/>
                    </columns>
                    <placeholder><Label text="No results" styleClass="text-muted"/></placeholder>
                </TableView>
            </VBox>

            <!-- Detail panel -->
            <VBox fx:id="detailPanel" styleClass="panel" spacing="12.0" prefWidth="320.0" minWidth="280.0">
                <padding><Insets top="20" right="16" bottom="20" left="16"/></padding>
                <Label text="Details" styleClass="panel-title"/>

                <Label text="Claim" styleClass="section-label"/>
                <Label fx:id="detailClaimLabel" wrapText="true" styleClass="claim-text"/>

                <Label text="Verdict" styleClass="section-label"/>
                <Label fx:id="detailVerdictLabel" styleClass="panel-title"/>

                <Label text="Explanation" styleClass="section-label"/>
                <TextArea fx:id="detailExplanationArea" prefHeight="140.0"
                          editable="false" wrapText="true" styleClass="explanation-area"/>

                <Label text="Sources (JSON)" styleClass="section-label"/>
                <Label fx:id="detailSourcesLabel" wrapText="true" styleClass="text-muted"
                       style="-fx-font-size:11px;"/>
            </VBox>
        </HBox>
    </center>
</BorderPane>
