<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sondhan.controller.LoginController"
           style="-fx-background-color: #FFFFFF; -fx-font-family: 'Segoe UI', Arial, sans-serif;">

    <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 16; -fx-border-color: #E2E8F0; -fx-border-radius: 16; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 4);"
          maxWidth="420.0" alignment="CENTER" spacing="16.0">
        <padding><Insets top="48" right="48" bottom="48" left="48"/></padding>

        <!-- Brand -->
        <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;"
               style="-fx-text-fill: #117065; -fx-font-size: 36px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>
        <Label text="AI Fact Checker"
               style="-fx-text-fill: #334155; -fx-font-size: 20px; -fx-font-weight: bold; -fx-alignment: CENTER;"/>
        <Label text="Sign in to verify claims with AI"
               style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>

        <Region minHeight="8.0"/>

        <!-- Error -->
        <Label fx:id="errorLabel"
               style="-fx-text-fill: #DC2626; -fx-background-color: #FEE2E2; -fx-background-radius: 8; -fx-padding: 8 12; -fx-font-size: 13px;"
               wrapText="true" maxWidth="330.0"/>

        <!-- Inputs -->
        <VBox spacing="10.0">
            <Label text="Email"
                   style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField" promptText="you@example.com"
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-prompt-text-fill: #94A3B8; -fx-font-size: 14px; -fx-padding: 10 14; -fx-pref-height: 42;"
                       onAction="#handleLogin"/>

            <Label text="Password"
                   style="-fx-text-fill: #475569; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            <PasswordField fx:id="passwordField" promptText="Your password"
                           style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-prompt-text-fill: #94A3B8; -fx-font-size: 14px; -fx-padding: 10 14; -fx-pref-height: 42;"
                           onAction="#handleLogin"/>
        </VBox>

        <ProgressIndicator fx:id="loadingSpinner" prefHeight="28.0"/>

        <Button fx:id="loginBtn" text="Sign In"
                style="-fx-background-color: #117065; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 20; -fx-cursor: hand; -fx-pref-height: 44;"
                maxWidth="Infinity" onAction="#handleLogin"/>

        <HBox alignment="CENTER" spacing="6.0">
            <Label text="New here?" style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
            <Hyperlink text="Create account" onAction="#handleRegister"
                       style="-fx-text-fill: #117065; -fx-font-size: 13px;"/>
        </HBox>

        <Hyperlink text="Continue as Guest (no account needed)"
                   onAction="#handleGuestMode"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
    </VBox>
</StackPane>
