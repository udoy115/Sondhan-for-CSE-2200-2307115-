<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.sondhan.controller.LoginController"
           styleClass="root-pane">

    <VBox styleClass="auth-card" maxWidth="420.0" alignment="CENTER" spacing="16.0">
        <padding><Insets top="48" right="48" bottom="48" left="48"/></padding>

        <!-- Brand -->
        <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;" styleClass="brand-logo"/>
        <Label text="AI Fact Checker" styleClass="brand-subtitle"/>
        <Label text="Sign in to verify claims with AI" styleClass="text-muted"/>

        <Region minHeight="8.0"/>

        <!-- Error -->
        <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="330.0"/>

        <!-- Inputs -->
        <VBox spacing="10.0">
            <Label text="Email" styleClass="field-label"/>
            <TextField fx:id="emailField" promptText="you@example.com"
                       styleClass="input-field" onAction="#handleLogin"/>

            <Label text="Password" styleClass="field-label"/>
            <PasswordField fx:id="passwordField" promptText="Your password"
                           styleClass="input-field" onAction="#handleLogin"/>
        </VBox>

        <ProgressIndicator fx:id="loadingSpinner" prefHeight="28.0"/>

        <Button fx:id="loginBtn" text="Sign In" styleClass="btn-primary"
                maxWidth="Infinity" onAction="#handleLogin"/>

        <HBox alignment="CENTER" spacing="6.0">
            <Label text="New here?" styleClass="text-muted"/>
            <Hyperlink text="Create account" onAction="#handleRegister" styleClass="link"/>
        </HBox>

        <Hyperlink text="Continue as Guest (no account needed)"
                   onAction="#handleGuestMode" styleClass="link-muted"/>
    </VBox>
</StackPane>
