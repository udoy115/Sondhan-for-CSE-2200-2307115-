<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.sondhan.controller.ImageBacktrackController"
            style="-fx-background-color: #F8FAFC; -fx-font-family: 'Segoe UI', Arial, sans-serif;"
            prefWidth="1100.0" prefHeight="720.0">

    <!-- ── Header ───────────────────────────────────────────────────────────── -->
    <top>
        <HBox style="-fx-background-color: #FFFFFF; -fx-border-color: transparent transparent #E2E8F0 transparent; -fx-border-width: 0 0 1 0;"
              alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets top="14" right="20" bottom="14" left="20"/></padding>
            <VBox>
                <Label text="&#x09B8;&#x09A8;&#x09CD;&#x09A7;&#x09BE;&#x09A8;"
                       style="-fx-text-fill: #117065; -fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label text="Image Backtracker"
                       style="-fx-text-fill: #64748B; -fx-font-size: 11px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="&#x1F310; Find where any image was first uploaded on the web"
                   style="-fx-text-fill: #64748B; -fx-font-size: 12px;"/>
            <Region minWidth="20"/>
            <Button text="&#x2190; Back to Home"
                    style="-fx-background-color: #FFFFFF; -fx-text-fill: #117065; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-color: #117065; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 14; -fx-cursor: hand;"
                    onAction="#handleBack"/>
        </HBox>
    </top>

    <!-- ── Body ─────────────────────────────────────────────────────────────── -->
    <center>
        <HBox spacing="16.0">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

            <!-- ── LEFT: Upload Panel ──────────────────────────────────────── -->
            <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;"
                  spacing="14.0" prefWidth="360.0" minWidth="320.0">
                <padding><Insets top="24" right="20" bottom="24" left="20"/></padding>

                <Label text="Upload an Image"
                       style="-fx-text-fill: #334155; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                <Label text="We'll search the web to find where it originated"
                       style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>

                <!-- Drop zone -->
                <StackPane fx:id="dropZone"
                           style="-fx-background-color: #F8FAFC; -fx-border-color: #CBD5E1; -fx-border-radius: 12; -fx-background-radius: 12; -fx-border-width: 2; -fx-border-style: dashed; -fx-cursor: hand;"
                           prefHeight="180.0" onMouseClicked="#handleBrowse">
                    <VBox fx:id="dropHint" alignment="CENTER" spacing="10.0">
                        <Label text="&#x1F4E4;" style="-fx-font-size: 40px;"/>
                        <Label text="Drag &amp; Drop image here"
                               style="-fx-text-fill: #117065; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                        <Label text="or click to browse files"
                               style="-fx-text-fill: #94A3B8; -fx-font-size: 12px;"/>
                    </VBox>
                    <ImageView fx:id="previewImage" visible="false"
                               fitWidth="320.0" fitHeight="175.0"
                               preserveRatio="true"/>
                </StackPane>

                <!-- File controls -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button text="Browse..."
                            style="-fx-background-color: #FFFFFF; -fx-text-fill: #117065; -fx-font-size: 13px; -fx-background-radius: 8; -fx-border-color: #117065; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 8 14; -fx-cursor: hand;"
                            onAction="#handleBrowse"/>
                    <Button fx:id="clearBtn" text="&#x2715; Clear"
                            style="-fx-background-color: transparent; -fx-text-fill: #64748B; -fx-font-size: 13px; -fx-padding: 8 12; -fx-cursor: hand; -fx-background-radius: 6;"
                            onAction="#handleClear" visible="false"/>
                    <Label fx:id="fileNameLabel" text="No file selected"
                           style="-fx-text-fill: #64748b; -fx-font-size: 12px;" HBox.hgrow="ALWAYS"
                           wrapText="true"/>
                </HBox>

                <!-- Image thumbnail info -->
                <VBox fx:id="imageInfoBox" spacing="4.0" visible="false" managed="false"
                      style="-fx-background-color: #F0FDF4; -fx-background-radius: 8; -fx-border-color: #BBF7D0; -fx-border-radius: 8; -fx-border-width: 1; -fx-padding: 10 12;">
                    <Label text="IMAGE READY" style="-fx-text-fill: #16A34A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                    <Label fx:id="imageDimLabel" text="" style="-fx-text-fill: #334155; -fx-font-size: 12px;"/>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <!-- Status row -->
                <HBox alignment="CENTER_LEFT" spacing="10.0" minHeight="28.0">
                    <ProgressIndicator fx:id="loadingSpinner" prefHeight="22.0" prefWidth="22.0" visible="false"/>
                    <Label fx:id="statusLabel" text=""
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"/>
                </HBox>

                <!-- Start button -->
                <Button fx:id="startBtn" text="&#x1F50D;  Start Backtracking"
                        style="-fx-background-color: #117065; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 12 20; -fx-cursor: hand;"
                        maxWidth="Infinity" disable="true" onAction="#handleStartBacktrack"/>
            </VBox>

            <!-- ── RIGHT: Results Panel ────────────────────────────────────── -->
            <VBox HBox.hgrow="ALWAYS" spacing="14.0">

                <!-- Empty state -->
                <VBox fx:id="emptyState" alignment="CENTER" spacing="16.0" VBox.vgrow="ALWAYS"
                      style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;">
                    <padding><Insets top="60" right="40" bottom="60" left="40"/></padding>
                    <Label text="&#x1F310;" style="-fx-font-size: 72px;"/>
                    <Label text="Image Origin Results"
                           style="-fx-text-fill: #334155; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                    <Label text="Upload any image and click Start Backtracking.&#10;We'll search the web and use AI to identify where the image first appeared online."
                           style="-fx-text-fill: #64748b; -fx-font-size: 13px;"
                           wrapText="true" textAlignment="CENTER" maxWidth="380.0"/>
                </VBox>

                <!-- Results (shown after backtrack) -->
                <ScrollPane fx:id="resultsScroll" HBox.hgrow="ALWAYS" fitToWidth="true"
                            VBox.vgrow="ALWAYS" visible="false" managed="false"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="14.0">

                        <!-- Origin summary card -->
                        <HBox spacing="14.0">
                            <!-- Earliest origin -->
                            <VBox style="-fx-background-color: #E6F4EA; -fx-background-radius: 12; -fx-border-color: #CEEAD6; -fx-border-radius: 12; -fx-border-width: 1;"
                                  spacing="6.0" HBox.hgrow="ALWAYS">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="LIKELY ORIGINAL SOURCE"
                                       style="-fx-text-fill: #117065; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="earliestSourceLabel" text=""
                                       style="-fx-text-fill: #137333; -fx-font-size: 18px; -fx-font-weight: bold;"
                                       wrapText="true"/>
                                <Label fx:id="originFoundLabel" text=""
                                       style="-fx-text-fill: #137333; -fx-font-size: 12px;"
                                       wrapText="true"/>
                            </VBox>

                            <!-- Match count badge -->
                            <VBox style="-fx-background-color: #EFF6FF; -fx-background-radius: 12; -fx-border-color: #BFDBFE; -fx-border-radius: 12; -fx-border-width: 1;"
                                  spacing="6.0" alignment="CENTER" prefWidth="140.0">
                                <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                                <Label text="PAGES FOUND"
                                       style="-fx-text-fill: #1D4ED8; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="matchCountLabel" text="0"
                                       style="-fx-text-fill: #1D4ED8; -fx-font-size: 36px; -fx-font-weight: bold;"/>
                            </VBox>
                        </HBox>

                        <!-- AI Analysis panel -->
                        <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;"
                              spacing="10.0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <Label text="&#x1F916; AI ORIGIN ANALYSIS"
                                       style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                                <Label text="Powered by Claude AI"
                                       style="-fx-background-color: #F0FDF4; -fx-text-fill: #16A34A; -fx-background-radius: 20; -fx-padding: 2 8; -fx-font-size: 11px;"/>
                            </HBox>
                            <TextArea fx:id="aiAnalysisArea"
                                      style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-text-fill: #334155; -fx-font-size: 13px; -fx-control-inner-background: #F8FAFC;"
                                      prefHeight="160.0" editable="false" wrapText="true"/>
                        </VBox>

                        <!-- Matched pages -->
                        <VBox style="-fx-background-color: #FFFFFF; -fx-background-radius: 12; -fx-border-color: #E2E8F0; -fx-border-radius: 12; -fx-border-width: 1;"
                              spacing="12.0">
                            <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>
                            <Label text="PAGES WHERE THIS IMAGE APPEARS"
                                   style="-fx-text-fill: #117065; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                            <VBox fx:id="matchesBox" spacing="8.0"/>
                            <Label fx:id="noMatchLabel"
                                   text="&#x26A0;  No matching pages found online. This image may be original or not yet indexed by search engines."
                                   style="-fx-text-fill: #B06000; -fx-font-size: 13px; -fx-background-color: #FEF7E0; -fx-background-radius: 8; -fx-padding: 10 12;"
                                   wrapText="true" visible="false" managed="false"/>
                        </VBox>

                    </VBox>
                </ScrollPane>

            </VBox>
        </HBox>
    </center>
</BorderPane>
